# Notion CMS Integration
NEXT_NOTION_API_KEY="secret_your_notion_integration_token"
NEXT_NOTION_DATABASE_ID="your_notion_database_id"

# Contact Form Mailing (Nodemailer / Gmail App Password)
# Note: Google requires a 16-character App Password (NOT your regular Gmail login password).
# Generate one at: https://myaccount.google.com/apppasswords (Requires 2-Step Verification to be ON).
NEXT_GMAIL_FROM_EMAIL="your_email@gmail.com"
NEXT_GMAIL_PASS="xxxx xxxx xxxx xxxx"
NEXT_GMAIL_TO_EMAIL="your_destination_email@gmail.com"

# Spotify Currently Playing Integration
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"
SPOTIFY_REFRESH_TOKEN="your_spotify_refresh_token"

# Duolingo Realtime Integration (Optional, defaults to Achmad96)
DUOLINGO_USERNAME="Kyanoee"

